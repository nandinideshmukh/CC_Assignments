aws ec2 create-key-pair \
--key-name mykey3 \
--query 'KeyMaterial' \
--output text > mykey3.pem


chmod 400 mykey3.pem

aws ec2 describe-vpcs \
--filters "Name=isDefault,Values=true" \
--query "Vpcs[0].VpcId" \
--output text

aws ec2 create-security-group \
--group-name mysg3 \
--description "SSH access" \
--vpc-id vpc-xxxxxxxx


aws ec2 authorize-security-group-ingress \
--group-id sg-08c79632831d97138 \
--protocol tcp \
--port 22 \
--cidr 0.0.0.0/0

aws ec2 describe-security-groups \
--query "SecurityGroups[*].[GroupId,GroupName]" \
--output table

aws ec2 describe-images \
--owners 099720109477 \
--filters "Name=name,Values=ubuntu/images/hvm-ssd/ubuntu-jammy-22.04-amd64-server-*" \
--query "Images | sort_by(@, &CreationDate)[-1].ImageId" \
--output text

Same command 2
aws ec2 run-instances \
--image-id ami-0826f7fac3eaaa32a \
--count 1 \
--instance-type t3.micro \
--key-name mykey3 \
--security-group-ids sg-03c74f54052c7a10a

private public ips
aws ec2 describe-instances \
--query "Reservations[*].Instances[*].[InstanceId,PrivateIpAddress,PublicIpAddress]" \
--output table


ssh -i mykey3.pem ubuntu@VM1_PUBLIC_IP
scp -i mykey3.pem mykey3.pem ubuntu@VM1_PUBLIC_IP:/home/ubuntu/
chmod 400 mykey3.pem
echo "hello from vm1" > file.txt
scp -i mykey3.pem file.txt ubuntu@VM2_PRIVATE_IP:/home/ubuntu/


ssh -i mykey3.pem ubuntu@VM2_PRIVATE_IP


